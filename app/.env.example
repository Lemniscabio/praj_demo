# Copy to .env.local for local use (gitignored by Vite).
# In production, set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# The access password users type into the login page.
# Recommendation: 20+ characters, random. Rotate by updating this and redeploying.
APP_PASSWORD=

# Secret used to HMAC-sign the session cookie. 32+ random bytes.
# Generate: `openssl rand -hex 32`
# Rotating this value invalidates all existing sessions (forces everyone to log in again).
AUTH_SECRET=
